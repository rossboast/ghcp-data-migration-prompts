# ============================================================================
# Oracle to Cosmos DB Migration - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to source control!

# ============================================================================
# ORACLE DATABASE CONFIGURATION
# ============================================================================
# Connection details for the source Oracle HR database

ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XEPDB1
ORACLE_USERNAME=hr
ORACLE_PASSWORD=your_oracle_password_here
ORACLE_SCHEMA=HR

# ============================================================================
# AZURE COSMOS DB CONFIGURATION
# ============================================================================
# Connection details for the target Cosmos DB database

# Cosmos DB account endpoint (find in Azure Portal > Keys)
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/

# Cosmos DB account key (Primary or Secondary key from Azure Portal)
COSMOS_KEY=your_cosmos_primary_key_here

# Database name (will be created if it doesn't exist)
COSMOS_DATABASE=hr_migration_db

# Preferred regions for multi-region writes (comma-separated, optional)
# Example: "East US,West US" or "UK South,UK West"
COSMOS_REGIONS=East US

# ============================================================================
# SPARK CONFIGURATION (Optional)
# ============================================================================
# Spark master URL - use local[*] for local development

SPARK_MASTER=local[*]

# ============================================================================
# MIGRATION CONFIGURATION (Optional)
# ============================================================================
# Additional configuration for the migration process

# Batch size for Cosmos DB writes (default: 1000)
MIGRATION_BATCH_SIZE=1000

# Enable verbose logging (true/false, default: false)
MIGRATION_VERBOSE=false

# Migration run ID (auto-generated if not provided)
# MIGRATION_RUN_ID=20251022_153045
