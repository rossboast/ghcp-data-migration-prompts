# Integration Test Configuration
# Copy this to .env and update with your settings

# Enable Docker Oracle (automatic container management)
USE_DOCKER_ORACLE=true

# Oracle Connection Settings (used if Docker is disabled)
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_USERNAME=hr
ORACLE_PASSWORD=hr

# Docker Oracle Settings
ORACLE_DOCKER_IMAGE=gvenzl/oracle-free:23-slim-faststart
ORACLE_CONTAINER_NAME=pytest-oracle-integration
ORACLE_AUTO_CLEANUP=false

# Cosmos DB Settings (if testing Cosmos integration)
# COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
# COSMOS_KEY=your-key-here
# COSMOS_DATABASE=testdb
# COSMOS_CONTAINER=test-container
